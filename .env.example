# DID of your labeler account (e.g. did:plc:xxxx)
DID=did:plc:your-labeler-did

# Private signing key for the labeler
SIGNING_KEY=your-signing-key

# Labeler account credentials
LABELER_IDENTIFIER=orglabeler.certified.one
LABELER_PASSWORD=your-app-password

# Public HTTP port for Caddy. Hosted platforms usually set PORT automatically.
PORT=8080

# Internal Next.js dashboard port behind Caddy
NEXT_PORT=3000

# Host to bind the labeler server to. 127.0.0.1 is enough when Caddy runs in the same container.
HOST=127.0.0.1

# Internal port for the labeler server (AT Protocol labeler endpoint behind Caddy)
LABELER_PORT=4100

# Port for the Prometheus metrics endpoint
METRICS_PORT=4101

# Path to SQLite database for snapshots, Jev assessments, jobs, admin sessions, and encrypted OAuth login state
ACTIVITY_DB_PATH=activity-log.db

# Path to the labels database (used by @skyware/labeler LabelerServer)
LABELS_DB_PATH=labels.db

# Public URL of the Caddy-fronted app/labeler endpoint (e.g. https://orglabeler.hypercerts.dev)
# /xrpc/* is routed to the labeler and dashboard/API routes are routed to Next.js.
NEXT_PUBLIC_LABELER_ENDPOINT=https://orglabeler.hypercerts.dev

# PDS URL for the labeler account (auto-detected during setup, override if needed)
PDS_URL=https://certified.one

# External Tap service URL. Tap runs as a separate service, not inside this app container.
TAP_URL=https://your-tap-service.example.com
TAP_ADMIN_PASSWORD=

# Comma-separated PDS hosts whose actors are authoritatively labeled likely-test.
# URL enrichment waits until each actor's PDS is known and skips matching test PDS hosts.
TEST_PDS_HOSTS=

# TypeSafe credentials and Jev assessment policy.
# Without a key, saved non-test records wait for configuration and existing labels remain stale.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_REQUEST_TIMEOUT_MS=15000
JEV_TEST_THRESHOLD=0.98
JEV_MAX_TEST_PROBABILITY_FOR_QUALITY=0.02
JEV_PURPOSE_THRESHOLD=0.95
JEV_QUALITY_THRESHOLD=0.95

# Verified AT Protocol OAuth admin login. Only DIDs in ADMIN_DIDS can receive a local session.
# Use the same stable public origin across deploys; metadata, JWKS, and callback URLs derive from it.
# OAuth client metadata: /api/admin/oauth/client-metadata
# Public JWKS: /api/admin/oauth/jwks
# Callback: /api/admin/oauth/callback
ADMIN_DIDS=
ADMIN_ORIGIN=https://orglabeler.hypercerts.dev
# Stable base64-encoded unencrypted P-256 PKCS#8 PRIVATE KEY PEM; never commit or rotate per deploy.
ADMIN_OAUTH_SIGNING_KEY=
# 32 random bytes as exactly 64 hex characters; encrypts PKCE/DPoP pre-auth state in ACTIVITY_DB_PATH.
ADMIN_OAUTH_ENCRYPTION_KEY=
ADMIN_SESSION_TTL_MS=28800000

# --- Railway deployment ---
# Mount a persistent volume at /app/data and set:
# ACTIVITY_DB_PATH=/app/data/activity-log.db
# LABELS_DB_PATH=/app/data/labels.db
