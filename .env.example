# DID of your labeler account (e.g. did:plc:xxxx)
DID=did:plc:your-labeler-did

# Signing key for the labeler (hex-encoded private key)
SIGNING_KEY=your-signing-key

# Bluesky account credentials for the labeler bot
BSKY_IDENTIFIER=your-handle.bsky.social
BSKY_PASSWORD=your-app-password

# Host to bind the labeler server to
# Use 0.0.0.0 in production (Railway) to bind to all interfaces
HOST=0.0.0.0

# Port for the labeler server (AT Protocol labeler endpoint)
LABELER_PORT=4100

# Port for the Prometheus metrics endpoint
METRICS_PORT=4101

# Jetstream WebSocket URL for firehose subscription
# jetstream2.us-west is recommended for Railway (US West region)
FIREHOSE_URL=wss://jetstream2.us-west.bsky.network/subscribe

# How often (ms) to persist the firehose cursor to disk
CURSOR_UPDATE_INTERVAL=60000

# Path to the SQLite database for activity log
ACTIVITY_DB_PATH=activity-log.db

# Public URL of the labeler endpoint (e.g. https://labeler.yourdomain.com)
# On Railway, set this to your service's public URL
LABELER_ENDPOINT=https://labeler.yourdomain.com

# PDS URL for the labeler account (auto-detected during setup, override if needed)
PDS_URL=https://climateai.org
