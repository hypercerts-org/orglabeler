{
  "name": "hyperlabel",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:labeler": "tsx src/labeler/start.ts",
    "dev:all": "concurrently --names \"next,labeler\" --prefix-colors \"blue,green\" \"npm run dev\" \"npm run dev:labeler\"",
    "start:all": "concurrently --names \"next,labeler\" --prefix-colors \"blue,green\" \"npm run start\" \"npm run dev:labeler\"",
    "set-labels": "tsx src/labeler/set-labels.ts",
    "setup": "tsx src/labeler/setup.ts",
    "reset": "tsx src/labeler/reset-db.ts"
  },
  "dependencies": {
    "@atproto/api": "^0.13.0",
    "@atproto/crypto": "^0.4.5",
    "@atproto/tap": "^0.2.4",
    "@huggingface/inference": "^4.13.12",
    "@skyware/bot": "^0.4.0",
    "@skyware/labeler": "^0.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "better-sqlite3": "^11.0.0",
    "concurrently": "^9.2.1",
    "dotenv": "^16.0.0",
    "express": "^4.21.0",
    "next": "^15.0.0",
    "next-themes": "^0.4.4",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.0.0"
  }
}
